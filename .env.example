# Defaults are local demonstration values only. Export these before running Mix.
PGHOST=localhost
PGPORT=55432
PGUSER=instantflow_runtime
RUNTIME_DB_PASSWORD=instantflow-runtime-local-only
# Separate migration/operator credentials; never give these to a production web process.
MIGRATION_PGUSER=postgres
MIGRATION_PGPASSWORD=instantflow-local-only
# Seeds require an explicit fictional-account password; choose 12+ characters.
DEMO_PASSWORD=
# Production requires DATABASE_URL, SECRET_KEY_BASE, PHX_HOST and PHX_SERVER=true.
