{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:instantflow:workflow:1.0",
  "title": "InstantFlow workflow 1.0",
  "description": "Portable definition only. Local bindings and operational records are excluded. Semantic validation is also required.",
  "type": "object",
  "properties": {
    "format_version": {
      "const": "1.0"
    },
    "template_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "template_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "locale": {
      "const": "pt-BR"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 10000
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "core",
          "finance",
          "operations",
          "documents",
          "participants",
          "communications"
        ]
      },
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true
    },
    "participants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/participant"
      },
      "minItems": 1,
      "maxItems": 30
    },
    "role_requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/role"
      },
      "minItems": 1,
      "maxItems": 30
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      },
      "minItems": 1,
      "maxItems": 100
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stage"
      },
      "minItems": 1,
      "maxItems": 100
    },
    "creation": {
      "type": "object",
      "properties": {
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "minItems": 1,
          "maxItems": 30,
          "uniqueItems": true
        }
      },
      "required": [
        "roles"
      ],
      "additionalProperties": false
    },
    "transitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transition"
      },
      "minItems": 0,
      "maxItems": 500
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      },
      "minItems": 1,
      "maxItems": 100
    },
    "assignment": {
      "type": "object",
      "properties": {
        "department_binding": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      },
      "required": [
        "department_binding"
      ],
      "additionalProperties": false
    },
    "views": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/view"
      },
      "minItems": 0,
      "maxItems": 20
    },
    "interface": {
      "type": "object",
      "properties": {
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "blocks": {
                "type": "array",
                "minItems": 1,
                "maxItems": 9,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "records",
                    "catalog",
                    "resources",
                    "items",
                    "batches",
                    "settlement",
                    "daily_summary",
                    "finance_setup",
                    "finance_summary"
                  ]
                }
              },
              "participant": {
                "$ref": "#/$defs/participant_page"
              }
            },
            "required": [
              "key",
              "label",
              "blocks"
            ],
            "additionalProperties": false
          }
        },
        "labels": {
          "type": "object",
          "properties": {
            "resource": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "resources": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "catalog": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "actor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "destination": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "lifecycle": {
          "type": "object",
          "properties": {
            "close_transition": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "required": [
            "close_transition"
          ],
          "additionalProperties": false
        },
        "access": {
          "type": "object",
          "properties": {
            "view": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "minItems": 1,
              "maxItems": 30,
              "uniqueItems": true
            },
            "configure": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "minItems": 1,
              "maxItems": 30,
              "uniqueItems": true
            },
            "operate": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "minItems": 1,
              "maxItems": 30,
              "uniqueItems": true
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "finance": {
          "type": "object",
          "properties": {
            "account_binding": {
              "type": "string"
            },
            "scope": {
              "enum": [
                "process",
                "shared_account"
              ]
            },
            "view_roles": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "maxItems": 30,
              "uniqueItems": true
            }
          },
          "required": [
            "account_binding",
            "scope",
            "view_roles"
          ],
          "additionalProperties": false
        },
        "operations": {
          "type": "object",
          "properties": {
            "version": {
              "const": 1
            },
            "actor": {
              "const": "captured_name"
            },
            "settlement": {
              "const": "full_manual"
            },
            "reporting_timezone": {
              "const": "organization"
            },
            "currency": {
              "const": "BRL"
            },
            "consumption": {
              "const": "estimated_product_units"
            },
            "payment_methods": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "cash",
                  "card",
                  "pix"
                ]
              }
            }
          },
          "required": [
            "version",
            "actor",
            "settlement",
            "reporting_timezone",
            "currency",
            "payment_methods",
            "consumption"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "pages"
      ],
      "additionalProperties": false
    },
    "communications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/communication"
      },
      "minItems": 0,
      "maxItems": 20
    }
  },
  "required": [
    "format_version",
    "template_key",
    "template_version",
    "locale",
    "name",
    "description",
    "capabilities",
    "role_requirements",
    "sections",
    "stages",
    "creation",
    "transitions",
    "bindings",
    "assignment",
    "views"
  ],
  "additionalProperties": false,
  "$defs": {
    "participant": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "enum": [
            "requester",
            "subject",
            "external"
          ]
        },
        "candidate_roles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "minItems": 0,
          "maxItems": 30,
          "uniqueItems": true
        },
        "managers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actor"
          },
          "minItems": 1,
          "maxItems": 30
        }
      },
      "required": [
        "key",
        "label",
        "kind",
        "managers"
      ],
      "additionalProperties": false
    },
    "role": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "key",
        "label"
      ],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type": {
          "enum": [
            "department",
            "budget"
          ]
        }
      },
      "required": [
        "key",
        "label",
        "type"
      ],
      "additionalProperties": false
    },
    "stage": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "initial": {
          "type": "boolean"
        },
        "terminal": {
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "label",
        "initial",
        "terminal"
      ],
      "additionalProperties": false
    },
    "field": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "document_policy": {
              "type": "object",
              "properties": {
                "reviewers": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/actor"
                  },
                  "minItems": 1,
                  "maxItems": 30
                },
                "max_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5242880
                },
                "media_types": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "application/pdf",
                      "image/png",
                      "image/jpeg"
                    ]
                  },
                  "minItems": 1,
                  "maxItems": 3,
                  "uniqueItems": true
                }
              },
              "required": [
                "reviewers",
                "max_bytes",
                "media_types"
              ],
              "additionalProperties": false
            },
            "reference": {
              "type": "object",
              "properties": {
                "target": {
                  "enum": [
                    "participant",
                    "subject"
                  ]
                },
                "relationship": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                },
                "cardinality": {
                  "const": "one"
                }
              },
              "required": [
                "target",
                "relationship",
                "cardinality"
              ],
              "additionalProperties": false
            },
            "type": {
              "enum": [
                "short_text",
                "long_text",
                "integer",
                "date",
                "datetime",
                "boolean",
                "directory_reference",
                "attachment"
              ]
            }
          },
          "required": [
            "key",
            "label",
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "type": {
              "const": "money"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          },
          "required": [
            "key",
            "label",
            "type",
            "currency"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "type": {
              "enum": [
                "single_choice",
                "multiple_choice"
              ]
            },
            "options": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true
            }
          },
          "required": [
            "key",
            "label",
            "type",
            "options"
          ],
          "additionalProperties": false
        }
      ]
    },
    "access": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "scope": {
          "enum": [
            "requester",
            "assigned_department",
            "workflow_department",
            "assigned_user",
            "participant"
          ]
        },
        "read": {
          "type": "boolean"
        },
        "edit_stages": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "department_binding": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "relationship": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "assignment_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      },
      "required": [
        "role",
        "scope",
        "read",
        "edit_stages"
      ],
      "additionalProperties": false
    },
    "actor": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "scope": {
          "enum": [
            "requester",
            "assigned_department",
            "workflow_department",
            "assigned_user",
            "participant"
          ]
        },
        "department_binding": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "relationship": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "assignment_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      },
      "required": [
        "role",
        "scope"
      ],
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "simulate_notification",
            "simulate_provisioning",
            "simulate_payment"
          ]
        },
        "behavior": {
          "enum": [
            "success",
            "fail_once",
            "failure"
          ]
        }
      },
      "required": [
        "type",
        "behavior"
      ],
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "classification": {
          "enum": [
            "internal",
            "restricted"
          ]
        },
        "access": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/access"
          },
          "minItems": 1,
          "maxItems": 100
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          },
          "minItems": 0,
          "maxItems": 300
        },
        "assignment": {
          "type": "object",
          "properties": {
            "managers": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/actor"
              },
              "minItems": 1,
              "maxItems": 20
            },
            "role": {
              "type": "string"
            },
            "department_binding": {
              "type": "string"
            },
            "stages": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "maxItems": 100
            }
          },
          "required": [
            "managers",
            "role",
            "department_binding",
            "stages"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "key",
        "label",
        "classification",
        "access",
        "fields"
      ],
      "additionalProperties": false
    },
    "guard": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "all",
                "any"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/nonNullGuard"
              },
              "minItems": 1,
              "maxItems": 20
            }
          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "delivery_succeeded"
            },
            "kind": {
              "enum": [
                "simulate_notification",
                "simulate_provisioning",
                "simulate_payment"
              ]
            }
          },
          "required": [
            "op",
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "present",
                "attachment_ready"
              ]
            },
            "field": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}\\.[a-z][a-z0-9_]{0,63}$"
            }
          },
          "required": [
            "op",
            "field"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "eq",
                "gt",
                "gte",
                "lt",
                "lte",
                "in"
              ]
            },
            "field": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}\\.[a-z][a-z0-9_]{0,63}$"
            },
            "value": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 10000
                    },
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                },
                {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 10000
                      },
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  },
                  "minItems": 1,
                  "maxItems": 100
                }
              ]
            }
          },
          "required": [
            "op",
            "field",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "communication_succeeded"
            },
            "communication": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "required": [
            "op",
            "communication"
          ],
          "additionalProperties": false
        }
      ]
    },
    "view": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type": {
          "enum": [
            "table",
            "board",
            "calendar",
            "assignments"
          ]
        },
        "columns": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}\\.[a-z][a-z0-9_]{0,63}$"
              },
              {
                "const": "stage"
              },
              {
                "const": "assigned_department"
              }
            ]
          },
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true
        },
        "visibility_roles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 30,
          "uniqueItems": true
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}[.][a-z][a-z0-9_]{0,63}$"
          },
          "minItems": 0,
          "maxItems": 10,
          "uniqueItems": true
        },
        "sort": {
          "type": "object",
          "properties": {
            "field": {
              "type": "string"
            },
            "direction": {
              "enum": [
                "asc",
                "desc"
              ]
            }
          },
          "required": [
            "field",
            "direction"
          ],
          "additionalProperties": false
        },
        "calendar_field": {
          "type": "string",
