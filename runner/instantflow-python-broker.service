[Unit]
Description=InstantFlow gVisor calculation broker
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=instantflow-runner
Group=instantflow-runner
SupplementaryGroups=docker nogroup
RuntimeDirectory=instantflow-python
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
EnvironmentFile=/etc/instantflow-python/broker.env
ExecStart=/usr/bin/python3 /opt/instantflow/runner/broker.py
WorkingDirectory=/opt/instantflow/runner
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
LimitCORE=0

[Install]
WantedBy=multi-user.target
