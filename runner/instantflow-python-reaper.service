[Unit]
Description=Remove expired InstantFlow Python sandbox containers
After=docker.service
[Service]
Type=oneshot
User=instantflow-runner
Group=instantflow-runner
SupplementaryGroups=docker
ExecStart=/usr/bin/python3 /opt/instantflow/runner/reap.py
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
